# Copy this file to .env and fill in the values. .env is gitignored; never commit it.
# docs/owner-setup.md says where each value comes from.

# Anthropic Console > API keys. Development key for the app's model calls.
ANTHROPIC_API_KEY=

# The bare domain the app lives on, for example example.com. Passkeys are tied to it permanently.
APP_DOMAIN=

# --- Supabase ---------------------------------------------------------------
# Project settings > API keys.
SUPABASE_URL=
# Publishable key (starts with sb_publishable_). The only Supabase key a browser may see.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). Bypasses row-level security. Server only:
# never sent to a browser and never given to the job runner.
SUPABASE_SECRET_KEY=
# Connect > Session pooler connection string. Used only to apply migrations.
SUPABASE_DB_URL=
# Account > Access Tokens. Used only to set the project's sign-in settings.
SUPABASE_ACCESS_TOKEN=
# Logins for the two app database roles. Written here by the setup script, not by hand.
APP_WORKER_DATABASE_URL=
APP_DISPATCHER_DATABASE_URL=

# --- Key service --------------------------------------------------------------
# Development only: 32 random bytes, base64. Stands in for the key service and
# refuses to start in production. Written here by the setup script.
LOCAL_KEK_BASE64=
# Production: AWS KMS. Added before the app holds any real data.
AWS_KMS_KEY_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Trigger.dev ------------------------------------------------------------
# Project > API keys: the production secret key.
TRIGGER_SECRET_KEY=
# Project settings: the reference starting proj_.
TRIGGER_PROJECT_REF=
# Profile > Personal Access Tokens. Used only to deploy.
TRIGGER_ACCESS_TOKEN=

# --- Cloudflare -------------------------------------------------------------
# My Profile > API Tokens. Workers edit, plus DNS edit and Email Routing edit on the app's domain.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Mail sender for sign-in codes ----------------------------------------------
# resend.com > API Keys, sending access.
RESEND_API_KEY=

# --- Telegram ---------------------------------------------------------------
# BotFather token. Added at the intake step.
TELEGRAM_BOT_TOKEN=
