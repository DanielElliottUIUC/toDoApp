# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# Anthropic Console > API keys. Development key for the app's model calls.
ANTHROPIC_API_KEY=

# Supabase. Added at the foundation step.
# Project URL: the Connect button at the top of the dashboard (https://<project-ref>.supabase.co).
SUPABASE_URL=
# Settings > API Keys > Publishable key. Safe in the browser once row-level security is on.
SUPABASE_PUBLISHABLE_KEY=
# Settings > API Keys > Secret keys. Server only; bypasses row-level security. Never ship to a client.
SUPABASE_SECRET_KEY=

# Trigger.dev project > API keys. Added at the foundation step.
TRIGGER_SECRET_KEY=

# Telegram BotFather token. Added at the intake step.
TELEGRAM_BOT_TOKEN=
