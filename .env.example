# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# Anthropic Console > API keys. Development key for the app's model calls.
ANTHROPIC_API_KEY=

# Supabase project settings > API keys. Added at the foundation step.
SUPABASE_URL=
# Publishable key (starts with sb_publishable_). The only Supabase key a browser may see.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). Bypasses row-level security. Server only:
# never sent to a browser and never given to the job runner.
SUPABASE_SECRET_KEY=

# Trigger.dev project > API keys. Added at the foundation step.
TRIGGER_SECRET_KEY=

# Telegram BotFather token. Added at the intake step.
TELEGRAM_BOT_TOKEN=
